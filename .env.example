# Supabase configuration
# Copy this file to .env and fill in your Supabase project credentials.
# Find these in Supabase Dashboard → Settings → API
# Do NOT commit .env to git.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# AI uses the authenticated Supabase ai-proxy Edge Function.
# Keep these flags false/unset for explicit demo mode.
# Set GEMINI_API_KEY and OPENAI_API_KEY only as Supabase server secrets.
EXPO_PUBLIC_STUDIO_AI_ENABLED=false
EXPO_PUBLIC_VOICE_AI_ENABLED=false

# Optional — Stripe Payment Link for the CraveMap Studio Starter Pack ($49).
# Paste the full https://buy.stripe.com/... URL from your Stripe Dashboard.
# If set: the Upgrade screen's CTA opens this URL.
# If unset: the Upgrade screen falls back to a "Contact to start paid pilot"
# mailto link. A dev-only "Record manual payment" button is also available
# in development builds for hackathon revenue evidence.
EXPO_PUBLIC_STUDIO_PAYMENT_LINK=

# Optional — base URL for share links (invite + restaurant landing pages).
# Defaults to the GitHub Pages deploy if unset. Override when cravemap.app ships.
EXPO_PUBLIC_WEB_BASE_URL=
