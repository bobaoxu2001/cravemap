# Supabase configuration
# Copy this file to .env and fill in your Supabase project credentials.
# Find these in Supabase Dashboard → Settings → API
# Do NOT commit .env to git.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI — used for voice search (Whisper speech-to-text).
# Without this key, voice search runs in demo mode with a mock transcript.
EXPO_PUBLIC_OPENAI_API_KEY=

# Google Gemini — used by CraveMap Studio for menu analysis and campaign generation.
# Get your key at: aistudio.google.com → Get API Key
# WARNING: This key is bundled into the app binary. Move to a Supabase Edge Function
# before wide distribution. See src/services/studio/gemini.ts for the migration path.
EXPO_PUBLIC_GEMINI_API_KEY=

# Optional — Stripe Payment Link for the CraveMap Studio Starter Pack ($49).
# Paste the full https://buy.stripe.com/... URL from your Stripe Dashboard.
# If set: the Upgrade screen's CTA opens this URL.
# If unset: the Upgrade screen falls back to a "Contact to start paid pilot"
# mailto link. A dev-only "Record manual payment" button is also available
# in development builds for hackathon revenue evidence.
EXPO_PUBLIC_STUDIO_PAYMENT_LINK=

# Optional — base URL for share links (invite + restaurant landing pages).
# Defaults to the GitHub Pages deploy if unset. Override when cravemap.app ships.
EXPO_PUBLIC_WEB_BASE_URL=
